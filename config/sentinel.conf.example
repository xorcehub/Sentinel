# sentinel.conf — example runtime configuration.
# Sentinel currently reads paths from CLI flags (see `sentinel -h`); this file
# documents the intended knobs and their defaults. Phase 2 will switch main.go
# to loading this file directly.

# --- paths ---
rules_dir       = "rules.d"                 # Sigma .yml rule files
allowlist_path  = "config/allowlist.json"   # JSONC allowlist (04-TELEMETRY.md §2)
state_path      = "state.db"                # bbolt dedup state
log_path        = "sentinel.log"            # structured log (append)
heartbeat_path  = "heartbeat.log"           # periodic alive+counts (05-ALERTING.md §5)

# --- logging ---
debug           = true                      # debug-level during Phase 1; drop to info after tuning
trace_events    = false                     # log every raw Sysmon event at DEBUG (firehose; duplicates the Windows event log). Off by default — enable only when tuning a rule miss. Distinct from debug so the structured log stays useful without the per-event dump.

# --- ingestion ---
sysmon_channel  = "Microsoft-Windows-Sysmon/Operational"

# --- heartbeat ---
heartbeat_interval = "5m"                   # <0 disables; 0 = default 5m

# --- single instance ---
# Empty (default) => derived at runtime as Global\Sentinel-Running-<current-user>.
# Set explicitly only if you need to override (e.g. run multiple instances per user).
mutex_name      = ""

# --- alerting (Phase 2+) ---
event_log_source = "Sentinel"               # registered via scripts/register-eventsource.ps1
# webhook_url     = ""                      # optional Discord/Slack/Teams

# --- file capture (forensics; see config/allowlist.json file_capture) ---
# Copies EID-11 FileCreate events whose path matches a file_capture pattern into
# a vault before they can be deleted — the Cursor Temp\ps-script-<guid>.ps1
# create-and-delete pattern. Best-effort (wins the race when the daemon processes
# the EID 11 within the file's lifetime); Sysmon FileDelete archiving is the
# guaranteed backstop. Patterns live in allowlist.json; these knobs are vault I/O.
# Empty snapshot_dir disables the feature (detection is unaffected either way).
snapshot_dir        = ""                     # e.g. "C:\\forensics\\sentinel-vault"; empty = off
snapshot_per_file_kb = 2048                  # cap per copy (oversize -> truncated); 0 = unlimited
snapshot_total_mb    = 500                   # vault cap; oldest evicted when exceeded; 0 = unlimited

# --- RE / maintenance mode (04-TELEMETRY.md §4) ---
# Set via CLI: `sentinel --suspend 90m --reason "pe_triage session"`. Max 4h.
