{
  // OUT-OF-THE-BOX DEFAULT — deliberately EMPTY: every rule armed, nothing
  // trusted, so expect toast noise until you tune. Make your tuning in your
  // own copy (route 1), not this file (a test keeps this one empty).
  //
  // How to tune for YOUR machine:
  //
  //   1. config/allowlist.json.local (gitignored) — copy from
  //      config/allowlist.json.example, prune for your box. The daemon uses
  //      it automatically whenever it exists and no -allowlist flag is given
  //      (same as rule overlays in rules.d/local/).
  //   2. Fork-style: edit THIS file directly if you maintain your own fork
  //      (git will show it modified; upstream keeps it empty).
  //
  // config/allowlist.json.example is your tuning reference: a real allowlist
  // with per-entry comments on the unusual syntax (JSONC, 4-backslash regex
  // path separators, drive-root anchors) and the noise class each entry kills.
  // Start from it rather than writing entries from scratch.
  //
  // ESCAPING: path separator = 4 backslashes (regex \\), literal dot before
  // extension = 2 backslashes (regex \.).

  "trusted_binaries": {
    "sha256": [],
    "path": [],
    "hash_gated_path": [],
    "allowed_signers": []
  },
  "allowed_destinations": {
    // Universal networks (RFCs, not machine-specific): loopback, private LAN,
    // link-local, multicast. Kept in the empty default so a fresh box isn't
    // toast-flooded by svchost/explorer talking to the router, DHCP, DNS and
    // discovery peers; everything else is trust-nothing. If your resolver uses
    // DoH (e.g. Cloudflare 1.1.1.1/1.0.0.1), add it when you tune — the
    // example carries it. Note: this set only feeds NET-002/003's dst except
    // (match-all minus this list); NET-004/NET-005 and every behavioral rule
    // ignore it.
    "cidr": [
      "127.0.0.0/8", "::1/128",
      "10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12",
      "169.254.0.0/16", "fe80::/10",
      "224.0.0.0/4", "ff00::/8"
    ]
  },
  "known_loopback_listeners": [],
  "dev_tool_paths": {
    "path": []
  },
  "dev_scripts": [],
  "event_log_filter": [],
  "file_capture": {
    "patterns": []
  }
}
