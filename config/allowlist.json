{
  // Sentinel starter allowlist. PRUNE before go-live (04-TELEMETRY.md §3).
  // ESCAPING: path separator = 4 backslashes (regex \\), literal dot before
  // extension = 2 backslashes (regex \.). SHA256 entries ROT on every tool
  // update — prefer path patterns for anything that re-signs frequently.

  "trusted_binaries": {
    "sha256": [
      // Add SHA256 of currently-on-disk firefox.exe, msedge.exe, etc. after
      // running scripts/gen-allowlist-seed.ps1 (TODO Phase 5). Left empty for
      // now; path patterns below carry coverage.
    ],
    "path": [
      "\\\\program files\\\\mozilla firefox\\\\.*\\.exe$",
      "\\\\program files(?: \\(x86\\))?\\\\microsoft\\\\edge(?:update|webview)?\\\\.*\\.exe$",
      "\\\\program files(?: \\(x86\\))?\\\\steam\\\\.*\\.exe$",
      "\\\\program files\\\\docker\\\\docker\\\\.*\\.exe$",
      "\\\\program files\\\\git\\\\.*\\\\(bash|grep|head|wc|git.*)\\.exe$",
      "\\\\program files\\\\7-zip\\\\.*\\.exe$",
      "\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\programs\\\\(?:cursor|.*?vscode.*?|python)\\\\.*\\.exe$",
      "\\\\users\\\\[^\\\\]+\\\\.cursor\\\\extensions\\\\.*\\\\claude-code-.*\\\\native-binary\\\\claude\\.exe$",
      "\\\\users\\\\[^\\\\]+\\\\.local\\\\bin\\\\claude\\.exe$",
      // Benign Windows session/service binaries BY NAME (NOT a blanket
      // System32 glob). Trusting \windows\system32\.*\.exe was a design
      // bug: it also trusted the LOLBins (powershell, conhost, mshta,
      // certutil, wscript, cscript, schtasks, regsvr32, rundll32, bitsadmin,
      // msiexec, forfiles, msdt) - the EXACT actors the behavior rules
      // target - so every rule with `except: image_in_allowlist` was silently
      // disabled for the incident binaries. This explicit list quiets
      // NET-002/003 (svchost/explorer phoning home) WITHOUT trusting the
      // LOLBins. Add a binary here only if it is NOT a LOLBin.
      "\\\\windows\\\\(?:explorer\\.exe$|(?:system32|syswow64)\\\\(svchost|dwm|runtimebroker|sihost|taskhostw|ctfmon|searchindexer|searchprotocolhost|searchfilterhost|fontdrvhost|dllhost|smss|csrss|wininit|winlogon|services|lsass|spoolsv|lsaiso|applicationframehost|shellexperiencehost|startmenuexperiencehost|textinputhost|systemsettings|securityhealthsystray|securityhealthservice|securityhealthsignalsutility|mousocoreworker|musnotifyicon|backgroundtaskhost|widgetsservice|phoneexperiencehost)\\.exe$)",
      "\\\\windows\\\\system32\\\\driverstore\\\\filerepository\\\\.*\\.exe$",
      "\\\\programdata\\\\microsoft\\\\windows defender\\\\.*\\\\(msmpeng|mpcmdrun|nis srv|mpdefendercoreservice)\\.exe$",
      "\\\\program files(?: \\(x86\\))?\\\\microsoft office\\\\.*\\.exe$"
    ]
  },
  "allowed_destinations": {
    "cidr": [
      "127.0.0.0/8", "::1/128",
      "10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12",
      "169.254.0.0/16", "fe80::/10",
      "224.0.0.0/4", "ff00::/8",
      "1.1.1.1/32", "1.0.0.1/32"
    ]
  },
  "known_loopback_listeners": [
    "127.0.0.1:9080"
    // Add: vite :5173, Cursor/Docker desktop ports, your app's dev ports.
  ],
  "dev_tool_paths": {
    "path": [
      "\\\\users\\\\[^\\\\]+\\\\go\\\\bin\\\\.*\\.exe$",
      "\\\\users\\\\[^\\\\]+\\\\.cargo\\\\bin\\\\.*\\.exe$",
      "\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\programs\\\\(?:python|node)\\\\.*\\.(exe|dll)$",
      "\\\\users\\\\[^\\\\]+\\\\appdata\\\\roaming\\\\npm\\\\.*\\.exe$",
      "\\\\program files\\\\docker\\\\docker\\\\.*\\.exe$",
      "\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\programs\\\\lm studio\\\\.*\\.exe$",
      "\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\pnpm\\\\.*\\.exe$",
      // pi-lite (operator's dev AI agent) — quiets NET-002/003. Scoped to the
      // built binary path, NOT the whole tree. Its API endpoints (128.14.69.x)
      // rotate, so trust the image rather than chasing each IP. NET-004
      // (Temp/AppData/ProgramData outbound) + NET-005 (loopback) still apply.
      "\\\\users\\\\[^\\\\]+\\\\documents\\\\github\\\\pi-lite\\\\dist\\\\pi-lite\\.exe$"
    ]
  },
  // dev_scripts: CmdLine-anchored exceptions for EXEC-001 (see allowlist doc).
  // The operator's own dev scripts run via `powershell -ep bypass -File <x>`;
  // anchoring on the script filename keeps EXEC-001 armed for everything else.
  // Filename anchor covers BOTH absolute (-File C:\\...\\pe-triage-docker.ps1)
  // and relative (-File ./scripts/pe-triage-docker.ps1) invocations.
  "dev_scripts": [
    "pe-triage-docker\\.ps1"
  ]
}
