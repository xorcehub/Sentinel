{
  // Sentinel starter allowlist. PRUNE before go-live (04-TELEMETRY.md §3).
  // ESCAPING: path separator = 4 backslashes (regex \\), literal dot before
  // extension = 2 backslashes (regex \.). SHA256 entries ROT on every tool
  // update — prefer path patterns for anything that re-signs frequently.

  "trusted_binaries": {
    "sha256": [
      // Add SHA256 of currently-on-disk firefox.exe, msedge.exe, etc. after
      // running scripts/gen-allowlist-seed.ps1 (TODO Phase 5). Left empty for
      // now; path patterns below carry coverage.
    ],
    "path": [
      "^[a-z]:\\\\program files\\\\mozilla firefox\\\\.*\\.exe$",
      "^[a-z]:\\\\program files(?: \\(x86\\))?\\\\microsoft\\\\edge(?:update|webview)?\\\\.*\\.exe$",
      "^[a-z]:\\\\program files(?: \\(x86\\))?\\\\steam\\\\.*\\.exe$",
      "^[a-z]:\\\\program files\\\\docker\\\\docker\\\\.*\\.exe$",
      "^[a-z]:\\\\program files\\\\git\\\\.*\\\\(bash|grep|head|wc|git.*)\\.exe$",
      "^[a-z]:\\\\program files\\\\7-zip\\\\.*\\.exe$",
      // Benign Windows session/service binaries BY NAME (NOT a blanket
      // System32 glob). Trusting \windows\system32\.*\.exe was a design
      // bug: it also trusted the LOLBins (powershell, conhost, mshta,
      // certutil, wscript, cscript, schtasks, regsvr32, rundll32, bitsadmin,
      // msiexec, forfiles, msdt) - the EXACT actors the behavior rules
      // target - so every rule with `except: image_in_allowlist` was silently
      // disabled for the incident binaries. This explicit list quiets
      // NET-002/003 (svchost/explorer phoning home) WITHOUT trusting the
      // LOLBins. Add a binary here only if it is NOT a LOLBin.
      // eventcreate.exe was trusted because Sentinel's eventlog alerter used
      // to shell to it with the alert body on its command line, which caused
      // the EVADE-001 feedback loop (the title carried 'System.dll'/'amsi',
      // EVADE-001's own match tokens). Level 3 (internal/alert/eventlog_windows.go)
      // replaced that shell-out with native ReportEventW, so the loop is now
      // structurally impossible and this trust is belt-and-suspenders for any
      // older deployed build still on the eventcreate path. Kept because it is
      // harmless (eventcreate only writes eventlog entries; no rule selects on
      // it as an actor) and guards a config/binary version mismatch.
      "^[a-z]:\\\\windows\\\\(?:explorer\\.exe$|(?:system32|syswow64)\\\\(svchost|dwm|runtimebroker|sihost|taskhostw|ctfmon|searchindexer|searchprotocolhost|searchfilterhost|fontdrvhost|dllhost|smss|csrss|wininit|winlogon|services|lsass|spoolsv|lsaiso|applicationframehost|shellexperiencehost|startmenuexperiencehost|textinputhost|systemsettings|securityhealthsystray|securityhealthservice|securityhealthsignalsutility|mousocoreworker|musnotifyicon|backgroundtaskhost|widgetsservice|phoneexperiencehost|eventcreate)\\.exe$)",
      "^[a-z]:\\\\windows\\\\system32\\\\driverstore\\\\filerepository\\\\.*\\.exe$",
      "^[a-z]:\\\\programdata\\\\microsoft\\\\windows defender\\\\.*\\\\(msmpeng|mpcmdrun|nis srv|mpdefendercoreservice)\\.exe$",
      "^[a-z]:\\\\program files(?: \\(x86\\))?\\\\microsoft office\\\\.*\\.exe$"
    ],
    // hash_gated_path: Tier-2 user-writable dev-tool paths. A path match
    // here is NOT trust by itself (Bypass B: the per-user username wildcard
    // lets malware running AS the user plant a same-path binary). Trust
    // additionally requires an Authenticode signature by one of
    // allowed_signers, verified lazily by internal/sigverify and cached by
    // SHA256. A legit auto-update (same vendor, new hash) re-verifies once
    // and re-trusts with zero operator action; a planted/unsigned mimic is
    // rejected whether it runs before or after the legit tool. Signers were
    // DISCOVERED by internal/sigverify's test against the on-disk binaries
    // (NOT guessed): Anysphere=Cursor, PSF=Python, Anthropic=claude.
    // Dev-tool vendors ONLY — never a LOLBin signer like Microsoft (signs
    // mshta/certutil). Patterns DUPLICATED in dev_tool_paths (below) on
    // PURPOSE: the two sets have different semantics — hash_gated_path grants
    // behavioral trust (Tier-2: path AND signature), dev_tool_paths is the
    // NET-002/003/004 quiet-by-path set. If you edit one, edit the other to
    // match, or the two will drift. No cross-check test exists; keep them in
    // sync by hand. Patterns copied verbatim from dev_tool_paths.
    "hash_gated_path": [
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\programs\\\\(?:cursor|.*?vscode.*?|python)\\\\.*\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\.cursor\\\\extensions\\\\.*\\\\claude-code-.*\\\\native-binary\\\\claude\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\.local\\\\bin\\\\claude\\.exe$"
    ],
    // allowed_signers: Authenticode subject names (simple-display type)
    // that auto-trust a Tier-2 path match. Verified against the real
    // on-disk binaries via internal/sigverify.Subjects. Add a vendor only
    // after running that discovery (a guessed string silently fails to
    // match and the tool stays untrusted — fail closed, but unintended).
    "allowed_signers": [
      "Anysphere, Inc.",
      "Python Software Foundation",
      "Anthropic, PBC"
    ]
  },
  "allowed_destinations": {
    "cidr": [
      "127.0.0.0/8", "::1/128",
      "10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12",
      "169.254.0.0/16", "fe80::/10",
      "224.0.0.0/4", "ff00::/8",
      "1.1.1.1/32", "1.0.0.1/32"
    ]
  },
  "known_loopback_listeners": [
    "127.0.0.1:9080"
    // Add: vite :5173, Cursor/Docker desktop ports, your app's dev ports.
  ],
  "dev_tool_paths": {
    "path": [
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\go\\\\bin\\\\.*\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\.cargo\\\\bin\\\\.*\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\programs\\\\(?:python|node)\\\\.*\\.(exe|dll)$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\roaming\\\\npm\\\\.*\\.exe$",
      "^[a-z]:\\\\program files\\\\docker\\\\docker\\\\.*\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\programs\\\\lm studio\\\\.*\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\pnpm\\\\.*\\.exe$",
      // pi-lite (operator's dev AI agent) — quiets NET-002/003. Scoped to the
      // built binary path, NOT the whole tree. Its API endpoints (128.14.69.x)
      // rotate, so trust the image rather than chasing each IP. NET-004
      // (Temp/AppData/ProgramData outbound) + NET-005 (loopback) still apply.
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\documents\\\\github\\\\pi-lite\\\\dist\\\\pi-lite\\.exe$",
      // bun runtime - operator JS toolchain. Trust image so NET-002/003
      // quiet down; NET-005 (loopback) still applies.
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\.bun\\\\bin\\\\.*\\.exe$",
      // uv-installed CPython (appdata/roaming/uv/python/<ver>/python.exe).
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\roaming\\\\uv\\\\python\\\\.*\\\\python\\.exe$",
      // Reclassified from trusted_binaries (interim Bypass-B hardening). These are
      // DUPLICATED in trusted_binaries.hash_gated_path (above) — edit both
      // together or they drift (see that section's comment). Here they serve
      // NET-002/003/004 quiet-by-path; there they grant behavioral trust only
      // with a valid allowed_signers signature.
      // USER-WRITABLE per-user paths, so path-trust alone let a planted mimic
      // (e.g. C:\Users\<you>\AppData\Local\Programs\Cursor\evil.exe) suppress every
      // image_in_allowlist rule. Moved here so ONLY NET-002/003/004 (which except
      // image_in_dev_tools) treat them as quiet-by-path; the behavioral rules
      // (EXEC/CRED/INJECT/PERSIST/EVADE) no longer suppress on these paths.
      // Full close = hash-authority (sha256 seed), tracked separately.
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\programs\\\\(?:cursor|.*?vscode.*?|python)\\\\.*\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\.cursor\\\\extensions\\\\.*\\\\claude-code-.*\\\\native-binary\\\\claude\\.exe$",
      "^[a-z]:\\\\users\\\\[^\\\\]+\\\\.local\\\\bin\\\\claude\\.exe$"
    ]
  },
  // dev_scripts: CmdLine-anchored exceptions for EXEC-001 (see allowlist doc).
  // The operator's own dev scripts run via `powershell -ep bypass -File <x>`;
  // anchoring on the script filename keeps EXEC-001 armed for everything else.
  // Filename anchor covers BOTH absolute (-File C:\\...\\pe-triage-docker.ps1)
  // and relative (-File ./scripts/pe-triage-docker.ps1) invocations.
  "dev_scripts": [
    "pe-triage-docker\\.ps1",
    // operator install/uninstall scripts. Path-anchored on the repo dir so a
    // same-named dropper (install.ps1 is a top-tier dropper name) can't evade
    // EXEC-001. Requires absolute-path invocation
    // (-File C:\\...\\leave-my-shit-alone\\install.ps1); a relative run
    // (-File .\\install.ps1) won't match here and will (safely) alert, which is
    // the correct failure for a one-shot, supervised install.
    "leave-my-shit-alone\\\\install\\.ps1",
    "leave-my-shit-alone\\\\uninstall\\.ps1",
    // Docker Desktop registry-list helper (cscript ...\regedit\vbs\regList.wsf).
    // Path-anchored on Docker's stable install subdir so a same-named payload
    // elsewhere (e.g. C:\ProgramData\reglist.wsf via cscript+http) can't evade
    // EXEC-003. Docker's real path is the only legit occurrence of that subtree.
    "regedit\\\\vbs\\\\reglist\\.wsf",
    // OEM "Control Center" (AiStone) logon script. A scheduled task fires
    // `powershell -ep bypass -File ...\AiStoneService\MyControlCenter\Command\LogonUserName.ps1`
    // at every logon (plus a `cmd /c -> powershell` wrapper variant). Path-anchored
    // on the admin-owned Program Files\OEM subtree; planting there already requires
    // admin = game over, so the path anchor is safe. One pattern covers both the
    // direct powershell and the cmd /c variants (same path substring).
    "aistoneservice\\\\mycontrolcenter\\\\command\\\\logonusername\\.ps1",
    // GCUBridge service-watchdog. A scheduled task runs
    // `powershell -WindowStyle Hidden -ep bypass -Command "Get-Service -Name 'GCUBridge';
    // if not running, Start-Service"` at every logon. Anchored on the GCUBridge
    // Get-Service probe (regex compiled (?i) case-insensitive); a real attacker won't
    // name their service GCUBridge AND use this exact watchdog form.
    "Get-Service -Name 'GCUBridge'",
  ],

  // event_log_filter: OPTIONAL log-only noise filter. Suppresses ONLY the
  // per-event DEBUG dump line (the raw "every event" telemetry) — it does NOT
  // affect rule evaluation, so a real HIT still alerts and logs on its own
  // "HIT" line regardless of this section.
  //
  // Semantics: AND of set fields WITHIN an entry, OR ACROSS entries. A field
  // is "set" only when you provide it; an omitted field is a wildcard. The
  // per-entry AND is what keeps this 1:1 safe: e.g. the powershell entry below
  // matches ONLY eid=11 (FileCreate) by powershell.exe with an EMPTY command
  // line — a powershell eid=11 that carries a command fails the "cmdline":"^$"
  // clause and is still logged.
  //
  // Escaping: same as trusted_binaries — 4 backslashes per literal path
  // separator (regex \\), 2 before a literal dot (regex \.). image regexes
  // are matched on the normalized lower path (e.g. c:\windows\...). cmdline
  // regexes on the raw command line, case-insensitive.
  "event_log_filter": [
    // #1: PowerShell FileCreate (eid 11) with no command line. This was ~24k
    // lines/day of pure noise — eid 11 carries no cmdline, and the real
    // persistence/config rules key on TargetFilename, not this dump line.
    { "eid": 11, "image": "\\\\windowspowershell\\\\v1\\.0\\\\powershell\\.exe$", "cmdline": "^$" },
    // #2: the editor's (Cursor) git poller firing check-ignore / rev-parse /
    // log --max-count / ls-files every couple seconds. ~20k lines/day. Read-
    // only inspection; no detection rule keys on these git subcommands.
    { "image": "\\\\git\\\\.*\\\\git\\.exe$", "cmdline": "(check-ignore|rev-parse|--max-count|ls-files)" }
  ],

  // file_capture: path patterns whose created files (EID 11) the daemon
  // snapshots to the forensic vault before they can be deleted. NOT an except
  // operator and NOT consulted by rule evaluation - purely additive forensics.
  // The motivating case: Cursor spawns `powershell -ep bypass -File
  // <TEMP>\ps-script-<guid>.ps1` and deletes the script the instant it exits,
  // so its contents are otherwise never inspectable. Snapshotting lets you read
  // what was actually run, and a later alert whose cmdline names a captured
  // path back-links its hid into that capture's manifest (see 05-ALERTING.md).
  //
  // This is best-effort: the daemon wins the race when it processes the EID 11
  // within the file's lifetime. Sysmon FileDelete archiving (Layer B, see
  // docs/05-ALERTING.md) is the guaranteed backstop for the misses.
  //
  // Escaping: same as trusted_binaries - 4 backslashes per literal path
  // separator (regex \\), matched on the normalized lower path. Vault I/O
  // (dir, size caps) is configured in sentinel.conf, not here.
  "file_capture": {
    "patterns": [
      // Cursor's create-and-delete bootstrap scripts. GUID-named so the
      // pattern anchors on the stable \Temp\ps-script- prefix, not the GUID.
      "\\\\temp\\\\ps-script-"
    ]
  }
}
